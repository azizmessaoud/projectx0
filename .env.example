# Umami analytics (client/index.html)
VITE_ANALYTICS_ENDPOINT=https://cloud.umami.is
VITE_ANALYTICS_WEBSITE_ID=your_website_id_here

# OAuth login URL (client/src/const.ts)
VITE_OAUTH_PORTAL_URL=
VITE_APP_ID=

# Frontend/Forge map proxy (client/src/components/Map.tsx)
VITE_FRONTEND_FORGE_API_URL=https://forge.butterfly-effect.dev
VITE_FRONTEND_FORGE_API_KEY=

# Build-time Forge storage proxy (vite.config.ts, dev server only)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Server
PORT=3000