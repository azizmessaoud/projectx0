# ============================================
# PORTFOLIO ENVIRONMENT VARIABLES
# ============================================

# ============================================
# BACKEND (Server) - Required for email service
# ============================================

# Resend API Key - Get from https://resend.com/api-keys
# Required for contact form to send emails
RESEND_API_KEY=re_your_api_key_here

# Node environment
NODE_ENV=development

# ============================================
# FRONTEND (Client) - Optional, for build time
# ============================================

# Backend API URL (used in production build)
# For local dev: http://localhost:5000
# For production: https://your-backend.vercel.app
VITE_API_URL=http://localhost:5000

# Deployment URL for OG images (optional)
# Used by vite-plugin-meta-images
VITE_DEPLOY_URL=http://localhost:5000

# ============================================
# DEPLOYMENT CHECKLIST
# ============================================
# 
# Local Development:
# 1. Copy this file to .env
# 2. Get Resend API key from https://resend.com
# 3. Replace RESEND_API_KEY with your key
# 4. Run: npm run dev
#
# Production (Backend on Vercel/Render):
# 1. Set RESEND_API_KEY in platform env vars
# 2. Set NODE_ENV=production
# 3. Note your backend URL
#
# Production (Frontend on GitHub Pages):
# 1. Update VITE_API_URL to your backend URL
# 2. Or hardcode in client/src/components/sections/contact.tsx
# 3. Run: npm run build
# 4. Deploy dist/public/ to GitHub Pages
#
# ============================================
